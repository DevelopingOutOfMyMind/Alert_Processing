# Environment Configuration
ENVIRONMENT=development

# Azure Configuration
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your_workspace_id

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# Application Configuration
APP_NAME=Alert Processing System
APP_VERSION=0.1.0
LOG_LEVEL=INFO
MAX_CONCURRENT_ALERTS=10

# Database Configuration (if needed)
DATABASE_URL=sqlite:///alerts.db

# Redis Configuration (for caching and queuing)
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1

# Alert Processing Configuration
ALERT_RETENTION_DAYS=30
MAX_ENRICHMENT_RETRIES=3
PII_ANONYMIZATION_ENABLED=true

# Monitoring and Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces